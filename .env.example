# Copy to .env (optional; git-ignored). Real environment variables always take precedence.
# Full reference with defaults and meaning: docs/operations.md

# ---- mode ------------------------------------------------------------------------------
# development (default): API open unless keys are set.  production: REQUIRES API keys, docs off.
SHIPINTEL_ENV=development

# ---- authentication / abuse protection --------------------------------------------------
# name:secret pairs; each secret >= 24 random characters (e.g. `openssl rand -hex 24`).
# SHIPINTEL_API_KEYS=ui:CHANGE_ME_24_PLUS_RANDOM_CHARS,partner:CHANGE_ME_24_PLUS_RANDOM_CHARS
SHIPINTEL_RATE_LIMIT_PER_MIN=60
SHIPINTEL_AUTH_FAIL_LIMIT_PER_MIN=10
# SHIPINTEL_TRUST_PROXY=false       # only behind exactly one proxy you control
# SHIPINTEL_CORS_ORIGINS=https://app.example
# SHIPINTEL_HSTS=false              # true when served over TLS
# SHIPINTEL_ENABLE_DOCS=true        # default: true in development, false in production

# ---- resource limits -------------------------------------------------------------------
SHIPINTEL_MAX_UPLOAD_MB=10
SHIPINTEL_MAX_PAGES=100
SHIPINTEL_MAX_TEXT_CHARS=1000000
SHIPINTEL_PROCESSING_TIMEOUT_S=30
SHIPINTEL_WORKERS=2
SHIPINTEL_WORKER_MEMORY_MB=2048
SHIPINTEL_QUEUE_TIMEOUT_S=10
SHIPINTEL_FUZZY_LABEL_BUDGET=300     # distinct fuzzy label lookups per document
# SHIPINTEL_ISOLATION=process       # 'inline' = no hard timeout/memory cap (tests/dev only)

# ---- optional features (operator policy: clients can switch these OFF, never ON) ---------
SHIPINTEL_OCR_ENABLED=false
SHIPINTEL_OCR_DPI=200
SHIPINTEL_OCR_LANG=eng
SHIPINTEL_OCR_MAX_PIXELS=25000000
SHIPINTEL_OCR_MAX_PAGES=20
SHIPINTEL_OCR_TIMEOUT_S=60          # per page
SHIPINTEL_OCR_TOTAL_TIMEOUT_S=120   # per document
# SHIPINTEL_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SHIPINTEL_NLP_ENABLED=false
SHIPINTEL_SPACY_MODEL=en_core_web_sm

# ---- logging ---------------------------------------------------------------------------
SHIPINTEL_LOG_LEVEL=INFO
SHIPINTEL_LOG_FORMAT=text           # json for log shippers

# ---- UI (operator-set only; users cannot choose a target) -------------------------------
# SHIPINTEL_API_URL=http://127.0.0.1:8000
# SHIPINTEL_API_KEY=<one of the keys above>
SHIPINTEL_UI_MAX_HISTORY=10
